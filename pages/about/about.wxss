.hero-mini {
  background: var(--color-ink);
  color: #fff;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.hero-brand {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.hero-mini-tag {
  font-size: 24rpx;
  opacity: 0.9;
}

/* Switchers (lang + role) */
.switcher {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.switcher-label {
  font-size: 26rpx;
  color: #555;
}

.switcher-tabs {
  display: flex;
  background: #f0f2f5;
  border-radius: 100rpx;
  padding: 4rpx;
}

.switcher-tab {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #555;
  border-radius: 100rpx;
  transition: all 0.2s;
}

.switcher-tab.active {
  background: var(--color-ink);
  color: #fff;
  font-weight: 500;
}

/* Text card */
.text {
  color: #444;
  line-height: 1.75;
  font-size: 28rpx;
}

/* Driver profile */
.profile-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  gap: 20rpx;
}

.profile-row:last-of-type { border-bottom: none; }

.pr-label {
  color: #888;
  flex-shrink: 0;
}

.pr-value {
  color: #222;
  font-weight: 500;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.pr-value.mono {
  font-family: monospace;
  letter-spacing: 1rpx;
}

.profile-status {
  margin: 20rpx 0;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.profile-status.status-approved {
  background: #d1fae5;
  color: #065f46;
}

.footer {
  text-align: center;
  color: #999;
  font-size: 22rpx;
  padding: 30rpx 0 10rpx;
}

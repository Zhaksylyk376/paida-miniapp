.contract-header {
  background: linear-gradient(135deg, #1a56db 0%, #3b82f6 100%);
  color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.contract-brand {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  opacity: 0.85;
  margin-bottom: 8rpx;
}

.contract-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.contract-meta {
  font-size: 22rpx;
  opacity: 0.85;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.mini-label {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 6rpx;
}

.value {
  font-size: 30rpx;
  color: #111;
  font-weight: 500;
}

.big { font-size: 34rpx; font-weight: 700; }
.mono { font-family: monospace; letter-spacing: 1rpx; }

.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

.section-h {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  gap: 20rpx;
}

.info-label { color: #888; flex-shrink: 0; }
.info-value {
  color: #111;
  font-weight: 500;
  text-align: right;
  flex: 1;
  word-break: break-all;
}
.info-value.mono { font-family: monospace; letter-spacing: 1rpx; }
.info-value.big { font-size: 32rpx; font-weight: 700; color: #1a56db; }

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-new        { background: #e0e7ff; color: #3730a3; }
.status-loaded     { background: #fef3c7; color: #92400e; }
.status-in_transit { background: #dbeafe; color: #1e40af; }
.status-at_border  { background: #fed7aa; color: #9a3412; }
.status-delivered  { background: #d1fae5; color: #065f46; }

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  background: #f5f7fa;
  color: #1a56db;
  border-radius: 100rpx;
  font-size: 25rpx;
  padding: 18rpx 0;
  border: none;
  font-weight: 500;
}

.action-btn::after { border: none; }

.action-btn.primary {
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  color: #fff;
}

.action-btn[disabled] {
  opacity: 0.4;
}

.hint-small {
  font-size: 22rpx;
  color: #aaa;
  text-align: center;
  margin-top: 12rpx;
}

.note-block {
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
  margin-top: 12rpx;
}

/* Timeline */
.timeline { padding-left: 20rpx; }

.tl-item {
  position: relative;
  padding-left: 30rpx;
  padding-bottom: 24rpx;
  border-left: 2rpx solid #e5e7eb;
}

.tl-item:last-child {
  border-left: 2rpx solid transparent;
  padding-bottom: 0;
}

.tl-dot {
  position: absolute;
  left: -10rpx;
  top: 6rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #d1d5db;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #d1d5db;
}

.tl-dot.active {
  background: #1a56db;
  box-shadow: 0 0 0 2rpx #1a56db;
}

.tl-status {
  font-size: 28rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 4rpx;
}

.tl-time {
  font-size: 22rpx;
  color: #999;
}

/* Next status buttons */
.next-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.next-btn {
  font-size: 28rpx !important;
  padding: 22rpx 0 !important;
}

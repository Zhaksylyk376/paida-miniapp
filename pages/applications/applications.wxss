.driver-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.driver-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.driver-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2740;
}

.driver-rating {
  font-size: 24rpx;
  color: var(--color-ink);
  background: #eaf0fe;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.driver-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #333;
  padding: 6rpx 0;
}

.dr-label { color: #8a94a6; }
.mono { font-family: monospace; letter-spacing: 1rpx; }

.driver-msg {
  margin: 14rpx 0;
  font-size: 26rpx;
  color: #555;
  background: #f5f7fa;
  padding: 16rpx;
  border-radius: 12rpx;
}

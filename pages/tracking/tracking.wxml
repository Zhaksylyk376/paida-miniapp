<view class="container">

  <view class="page-topbar">
    <lang-switch bindchange="onLangChanged" />
  </view>

  <!-- ============ CLIENT: PROCESS EXPLANATION ============ -->
  <block wx:if="{{role === 'client'}}">
    <view class="card">
      <view class="title">{{t.process_title}}</view>
      <view class="subtitle">{{t.process_subtitle}}</view>
    </view>

    <view class="process-timeline">
      <view class="process-item" wx:for="{{steps}}" wx:key="id">
        <view class="process-dot">
          <text class="process-dot-num">{{item.num}}</text>
        </view>
        <view class="process-content">
          <view class="process-title">{{item.title}}</view>
          <view class="process-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="process-note">{{t.process_note}}</view>
  </block>

  <!-- ============ DRIVER: AVAILABLE ORDERS ============ -->
  <block wx:else>
    <view class="card">
      <view class="title">{{t.available_title}}</view>
      <view class="subtitle">{{t.available_subtitle}}</view>
    </view>

    <block wx:if="{{availableOrders.length === 0}}">
      <view class="card empty">
        <view class="empty-icon">📭</view>
        <view class="empty-text">{{t.available_empty}}</view>
      </view>
    </block>

    <block wx:else>
      <view class="load-card" wx:for="{{availableOrders}}" wx:key="id">
        <view class="load-header">
          <view class="load-number">{{item.number}}</view>
          <view class="load-price" wx:if="{{item.price}}">$ {{item.price}}</view>
        </view>
        <view class="load-route">🛣 {{item.route || '—'}}</view>
        <view class="load-meta" wx:if="{{item.cargo}}">📦 {{item.cargo}}</view>
        <view class="load-meta muted">🕒 {{item.createdStr}}</view>

        <button class="btn-primary take-btn" bindtap="takeOrder" data-id="{{item.id}}">✋ {{t.available_take}}</button>
      </view>
    </block>
  </block>

</view>

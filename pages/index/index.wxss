/* ============ HERO ============ */
.hero {
  background: linear-gradient(135deg, #1a56db 0%, #3b82f6 60%, #60a5fa 100%);
  border-radius: 24rpx;
  padding: 60rpx 40rpx 50rpx;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 86, 219, 0.25);
}

.hero-brand {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  opacity: 0.85;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  line-height: 1.2;
}

.hero-subtitle {
  font-size: 28rpx;
  opacity: 0.92;
  margin-bottom: 40rpx;
  line-height: 1.55;
}

.hero-subtitle.mono {
  font-family: monospace;
  letter-spacing: 1rpx;
}

.hero-actions {
  display: flex;
  gap: 20rpx;
}

.hero-btn {
  flex: 1;
  font-size: 28rpx !important;
  padding: 22rpx 0 !important;
}

.hero-actions .btn-primary {
  background: #fff;
  color: #1a56db;
}

.hero-actions .btn-secondary {
  background: transparent;
  color: #fff;
  border-color: #fff;
}

/* Driver hero */
.driver-hero { text-align: center; padding: 50rpx 30rpx 40rpx; }
.driver-badge { font-size: 90rpx; margin-bottom: 14rpx; }

/* ============ STATS STRIP ============ */
.stats-strip {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-val {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a56db;
  line-height: 1;
  margin-bottom: 6rpx;
}

.stats-label {
  font-size: 22rpx;
  color: #666;
}

.stats-divider {
  width: 2rpx;
  height: 50rpx;
  background: #e5e7eb;
}

/* ============ SECTIONS ============ */
.section { margin-bottom: 36rpx; }

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: #111;
  padding-left: 8rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

/* ============ HOW IT WORKS ============ */
.how-grid {
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.how-step {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.how-step:last-child { border-bottom: none; }

.how-step-num {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.how-step-body { flex: 1; }

.how-step-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  color: #111;
}

.how-step-desc {
  font-size: 25rpx;
  color: #555;
  line-height: 1.55;
}

/* ============ CLIENTS ============ */
.clients {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.client-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.client-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
  width: 80rpx;
  text-align: center;
}

.client-content { flex: 1; }

.client-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  color: #111;
}

.client-desc {
  font-size: 25rpx;
  color: #666;
  line-height: 1.55;
}

/* ============ ADVANTAGES ============ */
.advantages {
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.adv-item {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.adv-item:last-child { border-bottom: none; }

.adv-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a56db, #3b82f6);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.adv-content { flex: 1; }

.adv-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  color: #111;
}

.adv-desc {
  font-size: 25rpx;
  color: #555;
  line-height: 1.55;
}

/* ============ FOOTER ============ */
.footer {
  text-align: center;
  color: #999;
  font-size: 22rpx;
  padding: 30rpx 20rpx 10rpx;
  line-height: 1.5;
}

/* ============ DRIVER CTA ============ */
.cta-registration,
.status-pending {
  text-align: center;
  padding: 40rpx 30rpx;
}

.cta-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.cta-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
  color: #111;
}

.cta-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.stats-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a56db;
  line-height: 1.1;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.quick-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.hint {
  text-align: center;
  color: #888;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  line-height: 1.5;
}

/* Вход в админ-панель */
.admin-entry {
  text-align: center;
  border: 2rpx solid #eaf0fe;
}
.admin-entry .cta-icon { font-size: 56rpx; }

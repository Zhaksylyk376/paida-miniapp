/* ================================================================
 *  Главная — сдержанный тёмно-навигационный акцент, никаких кислотных
 *  градиентов, крупная типографика, много воздуха.
 * ================================================================ */

/* ============ DEMO BANNER ============ */
.demo-banner {
  background: #fef3c7;
  color: #92400e;
  border: 1rpx solid #fcd34d;
  border-radius: var(--r-sm);
  padding: 14rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.4;
  margin-bottom: 16rpx;
  text-align: center;
}

/* ============ HERO ============ */
.hero {
  background: var(--color-ink);
  border-radius: var(--r-lg);
  padding: 52rpx 36rpx 44rpx;
  color: #fff;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.hero-brand {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  opacity: 0.55;
  margin-bottom: 24rpx;
  text-transform: uppercase;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
  line-height: 1.2;
  letter-spacing: -0.4rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  opacity: 0.7;
  margin-bottom: 36rpx;
  line-height: 1.6;
  max-width: 560rpx;
}

.hero-subtitle.mono {
  font-family: "SF Mono", "JetBrains Mono", Menlo, monospace;
  letter-spacing: 0.5rpx;
}

.hero-actions {
  display: flex;
  gap: 14rpx;
}

.hero-btn {
  flex: 1;
  font-size: 26rpx !important;
  padding: 20rpx 0 !important;
}

.hero-actions .btn-primary {
  background: #fff;
  color: var(--color-ink);
}

.hero-actions .btn-secondary {
  background: transparent;
  color: #fff;
  border-color: rgba(255,255,255,0.25);
}

/* Driver hero — минимализм, без гигантского эмодзи */
.driver-hero { padding: 44rpx 36rpx 40rpx; }
.driver-badge { display: none; }

/* ============ STATS STRIP ============ */
.stats-strip {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--r-md);
  padding: 26rpx 12rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-1);
}

.stats-item { flex: 1; text-align: center; }

.stats-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1;
  margin-bottom: 8rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.3rpx;
}

.stats-label {
  font-size: 22rpx;
  color: var(--color-text-3);
  letter-spacing: 0.3rpx;
}

.stats-divider {
  width: 1rpx;
  height: 44rpx;
  background: var(--color-border);
}

/* ============ SECTIONS ============ */
.section { margin-bottom: 40rpx; }

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  color: var(--color-ink);
  padding-left: 4rpx;
  letter-spacing: -0.3rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--color-text-3);
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

/* ============ HOW IT WORKS ============ */
.how-grid {
  background: var(--color-surface);
  border-radius: var(--r-md);
  padding: 6rpx 28rpx;
  box-shadow: var(--shadow-1);
}

.how-step {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.how-step:last-child { border-bottom: none; }

.how-step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--r-pill);
  background: var(--color-primary-t);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.how-step-body { flex: 1; }

.how-step-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  color: var(--color-ink);
}

.how-step-desc {
  font-size: 25rpx;
  color: var(--color-text-2);
  line-height: 1.55;
}

/* ============ ADVANTAGES ============ */
.advantages {
  background: var(--color-surface);
  border-radius: var(--r-md);
  padding: 6rpx 28rpx;
  box-shadow: var(--shadow-1);
}

.adv-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.adv-item:last-child { border-bottom: none; }

.adv-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--r-pill);
  background: var(--color-primary-t);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 22rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.adv-content { flex: 1; }

.adv-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
  color: var(--color-ink);
}

.adv-desc {
  font-size: 25rpx;
  color: var(--color-text-2);
  line-height: 1.55;
}

/* ============ FOOTER ============ */
.footer {
  text-align: center;
  color: var(--color-text-3);
  font-size: 22rpx;
  padding: 30rpx 20rpx 10rpx;
  line-height: 1.5;
}

/* ============ DRIVER CTA ============ */
.cta-registration,
.status-pending {
  text-align: center;
  padding: 40rpx 30rpx;
}

.cta-icon {
  font-size: 44rpx;
  margin-bottom: 14rpx;
  opacity: 0.6;
}

.cta-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  color: var(--color-ink);
}

.cta-desc {
  font-size: 26rpx;
  color: var(--color-text-2);
  line-height: 1.6;
  margin-bottom: 26rpx;
}

.stats-grid {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: var(--color-surface);
  border-radius: var(--r-md);
  padding: 32rpx 20rpx;
  text-align: center;
  box-shadow: var(--shadow-1);
}

.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-3);
  margin-top: 8rpx;
  letter-spacing: 0.3rpx;
}

.quick-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.hint {
  text-align: center;
  color: var(--color-text-3);
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  line-height: 1.5;
}

/* Вход в админ-панель */
.admin-entry {
  text-align: center;
  border: 1rpx solid var(--color-border);
  box-shadow: none;
}
.admin-entry .cta-icon { font-size: 36rpx; }

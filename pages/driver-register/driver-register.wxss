.form-item {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 10rpx;
}

.form-input {
  background: #f5f7fa;
  border-radius: 12rpx;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

/* ============ Документы ============ */
.doc-item {
  margin-top: 24rpx;
}

.doc-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.doc-uploader {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f7fa;
  border: 2rpx dashed #c8d0dc;
  box-sizing: border-box;
}

.doc-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.doc-badge {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx;
  background: rgba(26, 86, 219, 0.85);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
}

.doc-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.doc-plus {
  font-size: 64rpx;
  color: #1a56db;
  line-height: 1;
}

.doc-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8a94a6;
}

.hint-small {
  font-size: 24rpx;
  color: #8a94a6;
  margin: 8rpx 0 8rpx;
}

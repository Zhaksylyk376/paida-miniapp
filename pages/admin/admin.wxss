.driver-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.driver-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.driver-name { font-size: 30rpx; font-weight: 600; color: #1a2740; }

.driver-rating {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
  background: #8a94a6;
}
.driver-rating.status-pending  { background: #e08a1e; }
.driver-rating.status-approved { background: #1f9d55; }
.driver-rating.status-rejected { background: #d64545; }

.driver-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #333;
  padding: 6rpx 0;
}
.dr-label { color: #8a94a6; }
.mono { font-family: monospace; letter-spacing: 1rpx; }

.checks-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0;
}
.check-badge {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  background: #eaf7ee;
  color: #1f9d55;
}

.docs-thumbs {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}
.thumb {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.thumb-img {
  width: 100%;
  height: 150rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}
.thumb-cap {
  font-size: 20rpx;
  color: #8a94a6;
  margin-top: 8rpx;
  text-align: center;
}

.reject-reason {
  margin: 12rpx 0;
  font-size: 24rpx;
  color: #d64545;
  background: #fdecec;
  padding: 14rpx;
  border-radius: 12rpx;
}

.admin-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.action-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
}
.action-btn.primary { background: #1a56db; color: #fff; }
.action-btn.danger  { background: #fdecec; color: #d64545; }

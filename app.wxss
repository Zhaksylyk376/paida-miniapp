/* ================================================================
 *  Paida — единая дизайн-система
 *  Палитра сдержанная: navy как основной, приглушённый синий как акцент.
 *  Никаких кислотных градиентов, тени мягкие, отступы по шкале 8-4-3.
 * ================================================================ */
page {
  --color-bg:        #f6f7f9;
  --color-surface:   #ffffff;
  --color-border:    #e5e7ec;
  --color-text:      #0f172a;
  --color-text-2:    #475467;
  --color-text-3:    #98a2b3;

  --color-primary:   #1d4ed8;
  --color-primary-t: rgba(29, 78, 216, 0.08);
  --color-ink:       #0f172a;

  --shadow-1: 0 1rpx 2rpx rgba(15, 23, 42, 0.04), 0 2rpx 6rpx rgba(15, 23, 42, 0.04);
  --shadow-2: 0 2rpx 4rpx rgba(15, 23, 42, 0.04), 0 8rpx 24rpx rgba(15, 23, 42, 0.06);

  --r-sm: 10rpx;
  --r-md: 16rpx;
  --r-lg: 20rpx;
  --r-pill: 999rpx;

  background-color: var(--color-bg);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.5;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--color-surface);
  border-radius: var(--r-md);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-1);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 16rpx;
  letter-spacing: -0.2rpx;
}

.subtitle {
  font-size: 26rpx;
  color: var(--color-text-2);
  margin-bottom: 14rpx;
  line-height: 1.5;
}

.text {
  font-size: 26rpx;
  color: var(--color-text-2);
  line-height: 1.6;
}

/* --- Кнопки --- */
.btn-primary {
  background: var(--color-ink);
  color: #fff;
  border-radius: var(--r-pill);
  padding: 22rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  letter-spacing: 0.3rpx;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] { opacity: 0.4; }

.btn-secondary {
  background: var(--color-surface);
  color: var(--color-ink);
  border: 1rpx solid var(--color-border);
  border-radius: var(--r-pill);
  padding: 21rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}
.btn-secondary::after { border: none; }

.row { display: flex; align-items: center; }
.space-between { justify-content: space-between; }

.page-topbar {
  display: flex;
  justify-content: flex-end;
  padding-bottom: 8rpx;
}

/* --- Пустое состояние --- */
.empty { text-align: center; padding: 60rpx 30rpx; }
.empty-icon { font-size: 60rpx; margin-bottom: 12rpx; opacity: 0.35; }
.empty-text { font-size: 26rpx; color: var(--color-text-3); }

/* --- Табы-фильтры --- */
.filter-tabs {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  background: var(--color-surface);
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-1);
}
.filter-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--color-text-2);
  border-radius: var(--r-pill);
  transition: background 0.15s;
}
.filter-tab.active {
  color: #fff;
  background: var(--color-ink);
  font-weight: 500;
}

/* --- Подсказки --- */
.hint-small { font-size: 24rpx; color: var(--color-text-3); }
.hint-small.pad { padding: 24rpx; }

/* --- Заголовок секции --- */
.section-h {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 14rpx;
  letter-spacing: -0.2rpx;
}

/* --- Карточка заказа/рейса --- */
.load-card {
  background: var(--color-surface);
  border-radius: var(--r-md);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-1);
}
.load-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}
.load-number { font-size: 28rpx; font-weight: 600; color: var(--color-ink); letter-spacing: 0.5rpx; }
.load-price  { font-size: 28rpx; font-weight: 600; color: var(--color-ink); font-variant-numeric: tabular-nums; }
.load-route  { font-size: 26rpx; color: var(--color-text); margin: 6rpx 0; line-height: 1.5; }
.load-meta   { font-size: 24rpx; color: var(--color-text-2); margin: 4rpx 0; }
.load-meta.muted { color: var(--color-text-3); }

.load-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  color: #fff;
  background: var(--color-text-3);
  font-weight: 500;
}

.load-actions { margin-top: 14rpx; }
.status-btn {
  font-size: 26rpx;
  border-radius: var(--r-pill);
  padding: 14rpx 0;
  background: var(--color-primary-t);
  color: var(--color-primary);
  border: none;
  font-weight: 500;
}
.status-btn::after { border: none; }
.status-btn.primary { background: var(--color-ink); color: #fff; }
.status-btn.ghost { background: var(--color-primary-t); color: var(--color-primary); }

/* --- Цвета статусов (приглушённые) --- */
.status-new        { background: #64748b; }
.status-taken      { background: #1d4ed8; }
.status-loaded     { background: #7c3aed; }
.status-in_transit { background: #0284c7; }
.status-at_border  { background: #c2410c; }
.status-delivered  { background: #059669; }

.mono {
  font-family: "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
  letter-spacing: 0.5rpx;
}

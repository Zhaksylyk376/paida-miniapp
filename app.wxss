/* Глобальные стили */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #222;
  line-height: 1.5;
}

.container {
  padding: 30rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #1a56db, #2563eb);
  color: #fff;
  border-radius: 100rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #fff;
  color: #1a56db;
  border: 2rpx solid #1a56db;
  border-radius: 100rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.btn-secondary::after {
  border: none;
}

.row {
  display: flex;
  align-items: center;
}

.space-between {
  justify-content: space-between;
}

/* Верхняя панель с переключателем языка */
.page-topbar {
  display: flex;
  justify-content: flex-end;
  padding-bottom: 4rpx;
}

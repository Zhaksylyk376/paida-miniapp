/* Глобальные стили */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #222;
  line-height: 1.5;
}

.container {
  padding: 30rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #1a56db, #2563eb);
  color: #fff;
  border-radius: 100rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #fff;
  color: #1a56db;
  border: 2rpx solid #1a56db;
  border-radius: 100rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.btn-secondary::after {
  border: none;
}

.row {
  display: flex;
  align-items: center;
}

.space-between {
  justify-content: space-between;
}

/* Верхняя панель с переключателем языка */
.page-topbar {
  display: flex;
  justify-content: flex-end;
  padding-bottom: 4rpx;
}

/* ===== Общие переиспользуемые классы (глобально) ===== */

/* Пустое состояние */
.empty {
  text-align: center;
  padding: 60rpx 30rpx;
}
.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #8a94a6;
}

/* Табы-фильтры */
.filter-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.filter-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.filter-tab.active {
  color: #fff;
  background: #1a56db;
}

/* Подсказка */
.hint-small {
  font-size: 24rpx;
  color: #8a94a6;
}
.hint-small.pad { padding: 24rpx; }

/* Заголовок секции */
.section-h {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2740;
  margin-bottom: 16rpx;
}

/* Карточка заказа/рейса (общая) */
.load-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.load-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.load-number { font-size: 30rpx; font-weight: 600; color: #1a2740; }
.load-price  { font-size: 30rpx; font-weight: 600; color: #1a56db; }
.load-route  { font-size: 28rpx; color: #333; margin: 8rpx 0; }
.load-meta   { font-size: 26rpx; color: #555; margin: 4rpx 0; }
.load-meta.muted { color: #8a94a6; }
.load-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
  background: #8a94a6;
}
.load-actions { margin-top: 16rpx; }
.status-btn {
  font-size: 26rpx;
  border-radius: 100rpx;
  padding: 16rpx 0;
  background: #f5f7fa;
  color: #1a56db;
}
.status-btn::after { border: none; }
.status-btn.primary { background: #1a56db; color: #fff; }
.status-btn.ghost { background: #eef2fb; color: #1a56db; }

/* Цвета статусов */
.status-new        { background: #6b7280; }
.status-taken      { background: #2563eb; }
.status-loaded     { background: #7c3aed; }
.status-in_transit { background: #0ea5e9; }
.status-at_border  { background: #e08a1e; }
.status-delivered  { background: #1f9d55; }

.mono { font-family: monospace; letter-spacing: 1rpx; }
